{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rizumu85/rizum-glass/adapters/gpuix/reference-contract.schema.json",
  "title": "Rizum Glass GPUIX Reference Contract",
  "type": "object",
  "required": ["reference", "runtime", "viewport", "nativeCalibration", "interactionOwnership", "platformChrome", "components", "motion", "materialFallbacks", "capabilityFallbacks"],
  "properties": {
    "$schema": { "type": "string" },
    "reference": {
      "type": "object",
      "required": ["stack", "source", "approvedAt"],
      "properties": {
        "stack": { "const": "React + TypeScript + Vite + Tailwind CSS + shadcn/ui + Rizum Glass" },
        "source": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["bun", "react", "gpuixReact", "gpuixNative"],
      "properties": {
        "bun": { "type": "string", "minLength": 1 },
        "react": { "type": "string", "pattern": "^19\\." },
        "gpuixReact": { "type": "string", "minLength": 1 },
        "gpuixNative": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height", "scale"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "nativeCalibration": {
      "type": "object",
      "required": ["referenceScale", "nativeScale", "strategy", "scaleTogether", "opticalExceptions", "evidence"],
      "properties": {
        "referenceScale": { "type": "number", "exclusiveMinimum": 0 },
        "nativeScale": { "type": "number", "exclusiveMinimum": 0 },
        "strategy": { "type": "string", "minLength": 1 },
        "scaleTogether": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "opticalExceptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "interactionOwnership": {
      "type": "object",
      "required": ["staticTextSelection", "editableTextSelection", "pointerCapture", "wheelRouting", "sensitiveValues"],
      "properties": {
        "staticTextSelection": { "enum": ["disabled", "enabled"] },
        "editableTextSelection": { "enum": ["native-editor", "custom-documented"] },
        "pointerCapture": { "type": "string", "minLength": 1 },
        "wheelRouting": { "type": "string", "minLength": 1 },
        "sensitiveValues": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "platformChrome": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "controlOwnership", "reservedRegionSource", "outerCornerSource", "unsupportedFallback", "evidence"],
        "properties": {
          "platform": { "enum": ["windows", "macos", "linux"] },
          "controlOwnership": { "const": "system" },
          "reservedRegionSource": { "enum": ["runtime-measured", "native-titlebar"] },
          "outerCornerSource": { "const": "platform" },
          "unsupportedFallback": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "primitive", "dimensions", "tokens", "states"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "primitive": { "type": "string", "minLength": 1 },
          "dimensions": {
            "type": "object",
            "required": ["preferredWidth", "preferredHeight"],
            "properties": {
              "minWidth": { "type": ["number", "null"] },
              "preferredWidth": { "type": "number", "exclusiveMinimum": 0 },
              "maxWidth": { "type": ["number", "null"] },
              "preferredHeight": { "type": "number", "exclusiveMinimum": 0 },
              "padding": { "type": "string" },
              "gap": { "type": "number" }
            },
            "additionalProperties": false
          },
          "tokens": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "evidence"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "motion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "durationMs", "easing", "interruptible", "reducedMotion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "durationMs": { "type": "number", "minimum": 0 },
          "easing": { "type": "string", "minLength": 1 },
          "interruptible": { "type": "boolean" },
          "reducedMotion": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "materialFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["webEffect", "gpuixStrategy", "acceptedDifference"],
        "properties": {
          "webEffect": { "type": "string", "minLength": 1 },
          "gpuixStrategy": { "type": "string", "minLength": 1 },
          "acceptedDifference": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "capabilityFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["webCapability", "runtimeFinding", "gpuixStrategy", "acceptedDifference", "verification"],
        "properties": {
          "webCapability": { "type": "string", "minLength": 1 },
          "runtimeFinding": { "type": "string", "minLength": 1 },
          "gpuixStrategy": { "type": "string", "minLength": 1 },
          "acceptedDifference": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
